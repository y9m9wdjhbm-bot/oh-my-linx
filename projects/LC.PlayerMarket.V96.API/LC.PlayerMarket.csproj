<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Version>96.0.1</Version>
    <AssemblyName>LC.PlayerMarket.V96.API</AssemblyName>
    <Product>LC PlayerMarket V96 API</Product>
    <Title>LC PlayerMarket V96 API</Title>
    <Description>LC PlayerMarket V96 API resident native worker and optional additional 100-5000ms page wait</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="verification/**/*.cs;engine/**/*.cs;NavigationSource/**/*;Navigation/**/*;vendor/Navigation/**/*;WireV7/**/*.cs;MainForm.Minimap.cs;Minimap/**/*.cs" />
    <Compile Include="engine/Broker/**/*.cs" />
    <ProjectReference Include="engine/Core/MemoryHub.Core.csproj" />
    <ProjectReference Include="engine/Reader/MemoryHub.Reader.csproj" />
    <Content Include="profiles/**/*;ShopControl/**/*;Navigation/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="vendor/Navigation/**/*" Link="Navigation/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="verification/page-range-v2/*.jsonl" />
    <EmbeddedResource Include="verification/force-preflight/*.jsonl" />
    <EmbeddedResource Include="verification/owner-changed-preflight-v1/*.jsonl" />
    <EmbeddedResource Include="verification/packet-copy-preflight-v1/*.jsonl" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="verification/integration-v95/single-baseline-actual-v1.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="verification/resident-v18/returned-v17-template.jsonl" /></ItemGroup>
</Project>
